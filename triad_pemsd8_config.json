{
    "task": "traffic_state_pred",
    "model": "TRIAD",
    "dataset": "PEMSD8",
    
    "input_dim": 1,
    "x_feature_dim": 3,
    
    "hid_dim": 112,
    "d_out": 448,
    "n_heads": 4,
    "M": 16,
    "num_layers": 2,
    "tau": 3,
    
    "att_type": "proxy",
    "query_cross_time": 1,
    "return_att": 0,
    "prob_factor": 5,
    
    "use_adaptive_lag": true,
    "max_lag": 5,
    "lag_tau": 0.7,
    
    "use_ms_decomp": true,
    "ms_decomp_scales": [3, 5, 9],
    "ms_decomp_temp": 0.7,
    "ms_decomp_dropout": 0.03,
    "ms_decomp_norm": "ln",
    
    "norm_flag": "first",
    "enc_dropout": 0.08,
    "att_dropout": 0.08,
    "emb_dropout": 0.05,
    "te_emb_dropout": 0.05,
    "se_emb_dropout": 0.05,
    "tle_emb_dropout": 0.08,
    
    "activation_data": "gelu",
    "activation_enc": "gelu",
    "activation_dec": "gelu",
    
    "scaler": "standard",
    "load_external": true,
    "normal_external": false,
    "ext_scaler": "none",
    "add_time_in_day": true,
    "add_day_in_week": true,
    "slice_size_per_day": 288,
    "input_window": 12,
    "output_window": 12,
    "output_dim": 1,
    "batch_size": 48,
    
    "seed": 50,
    "max_epoch": 150,
    "learner": "adamw",
    "learning_rate": 0.0008,
    "weight_decay": 0.0005,
    "lr_decay": true,
    "lr_scheduler": "cosinelr",
    "lr_eta_min": 5e-06,
    "lr_decay_ratio": 0.1,
    "lr_warmup_epoch": 8,
    "lr_warmup_init": 5e-06,
    "clip_grad_norm": true,
    "max_grad_norm": 3,
    "use_early_stop": true,
    "patience": 30,
    
    "huber_delta": 2,
    "set_loss": "huber",
    "metrics": ["masked_MAE", "masked_RMSE", "masked_MAPE"],
    
    "gpu": true,
    "gpu_id": [0],
    "train": true,
    "cache_dataset": true,
    "num_workers": 0,
    "pad_with_last_sample": true,
    "train_rate": 0.6,
    "eval_rate": 0.2
}
