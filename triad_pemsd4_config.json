{
    "task": "traffic_state_pred",
    "model": "TRIAD",
    "dataset": "PEMSD4",

    "input_dim": 1,
    "x_feature_dim": 3,

    "hid_dim": 112,
    "d_out": 448,
    "n_heads": 4,
    "M": 20,
    "num_layers": 2,
    "tau": 3,

    "att_type": "proxy",
    "query_cross_time": 1,
    "return_att": 0,
    "prob_factor": 5,

    "use_adaptive_lag": true,
    "max_lag": 6,
    "lag_tau": 0.6,

    "use_ms_decomp": true,
    "ms_decomp_scales": [3, 5, 7],
    "ms_decomp_temp": 0.6,
    "ms_decomp_dropout": 0.05,
    "ms_decomp_norm": "ln",

    "norm_flag": "first",
    "enc_dropout": 0.10,
    "att_dropout": 0.10,
    "emb_dropout": 0.08,
    "te_emb_dropout": 0.08,
    "se_emb_dropout": 0.08,
    "tle_emb_dropout": 0.10,

    "activation_data": "gelu",
    "activation_enc": "gelu",
    "activation_dec": "gelu",

    "scaler": "standard",
    "load_external": true,
    "normal_external": false,
    "ext_scaler": "none",
    "add_time_in_day": true,
    "add_day_in_week": true,
    "slice_size_per_day": 288,
    "input_window": 12,
    "output_window": 12,
    "output_dim": 1,
    "batch_size": 24,

    "seed": 42,
    "max_epoch": 200,
    "learner": "adamw",
    "learning_rate": 0.0004,
    "weight_decay": 0.001,
    "lr_decay": true,
    "lr_scheduler": "cosinelr",
    "lr_eta_min": 1e-06,
    "lr_decay_ratio": 0.1,
    "lr_warmup_epoch": 10,
    "lr_warmup_init": 1e-06,
    "clip_grad_norm": true,
    "max_grad_norm": 2,
    "use_early_stop": true,
    "patience": 40,

    "huber_delta": 1.5,
    "set_loss": "huber",
    "metrics": ["masked_MAE", "masked_RMSE", "masked_MAPE"],

    "gpu": true,
    "gpu_id": [0],
    "train": true,
    "cache_dataset": true,
    "num_workers": 0,
    "pad_with_last_sample": true,
    "train_rate": 0.6,
    "eval_rate": 0.2
}

