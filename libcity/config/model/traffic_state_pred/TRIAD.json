{
    "input_dim": 1,
    "x_feature_dim": 3,
    "hid_dim": 64,
    "d_out": 512,
    "n_heads": 4,
    "M": 8,
    "num_layers": 2,
    "tau": 3,
    
    "att_type": "proxy",
    "query_cross_time": 1,
    "return_att": 0,
    "prob_factor": 5,
    
    "use_adaptive_lag": true,
    "max_lag": 6,
    "lag_tau": 1.0,
    
    "use_ms_decomp": true,
    "ms_decomp_scales": [3, 7, 13],
    "ms_decomp_temp": 1.0,
    "ms_decomp_dropout": 0.0,
    "ms_decomp_norm": "ln",
    
    "norm_flag": "first",
    "enc_dropout": 0.1,
    "att_dropout": 0.1,
    "emb_dropout": 0.1,
    "te_emb_dropout": 0.1,
    "se_emb_dropout": 0.1,
    "tle_emb_dropout": 0.1,
    
    "activation_data": "relu",
    "activation_enc": "gelu",
    "activation_dec": "gelu",
    
    "scaler": "standard",
    "load_external": true,
    "normal_external": false,
    "ext_scaler": "none",
    "add_time_in_day": true,
    "add_day_in_week": true,
    "slice_size_per_day": 288,
    "batch_size": 32,
    
    "seed": 42,
    "max_epoch": 200,
    "learner": "adamw",
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "lr_decay": true,
    "lr_scheduler": "cosinelr",
    "lr_eta_min": 1e-06,
    "lr_decay_ratio": 0.1,
    "lr_warmup_epoch": 10,
    "lr_warmup_init": 1e-07,
    "clip_grad_norm": true,
    "max_grad_norm": 5,
    "use_early_stop": true,
    "patience": 30,
    
    "huber_delta": 2,
    "set_loss": "mae"
}
